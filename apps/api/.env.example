HOST=127.0.0.1
PORT=8787
DB_PATH=./data/dma-hub.sqlite
WEB_ORIGIN=http://localhost:5173

# Email verification and password recovery are OFF without a sender.
# Configure with a verified sender domain before turning on verification.
# RESEND_API_KEY=your-server-only-secret
# MAIL_FROM=DMA Hub <security@your-domain.example>
REQUIRE_EMAIL_VERIFICATION=0

# Optional local-only HMAC sandbox webhook secret. NEVER use a real payment-provider key here.
# DMA_SANDBOX_WEBHOOK_SECRET=replace-with-32-or-more-random-characters

# Optional Stripe TEST-mode only integration; all four values are required.
# No sk_live or rk_live keys are accepted. Never put secrets in VITE_ variables.
# STRIPE_TEST_SECRET_KEY=sk_test_your-server-only-key
# STRIPE_TEST_WEBHOOK_SECRET=whsec_your-webhook-endpoint-test-secret
# STRIPE_TEST_SUCCESS_URL=http://localhost:5173/#/billing
# STRIPE_TEST_CANCEL_URL=http://localhost:5173/#/billing
