{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DMA Hub",
  "version": "0.2.0",
  "identifier": "com.dmahub.desktop",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../.. run dev",
    "beforeBuildCommand": "npm --prefix ../.. run build"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "DMA Hub — Desktop Preview",
      "url": "index.html#/launcher",
      "width": 1240,
      "height": 810,
      "minWidth": 900,
      "minHeight": 650,
      "backgroundColor": "#07121e",
      "visible": true
    }],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "shortDescription": "DMA Hub Windows desktop workspace preview",
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  }
}