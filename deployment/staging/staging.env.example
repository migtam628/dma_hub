# PRIVATE/LOOPBACK STAGING ONLY. Never expose :8787 on a public interface.
# Copy this file to staging.env and chmod 600. Do not commit staging.env.
WEB_ORIGIN=http://localhost:5173

# The API can run without email in PRIVATE test staging only.
# Production registration requires independently configured transactional email.
REQUIRE_EMAIL_VERIFICATION=0

# Optional: server-side mailer for controlled verification/recovery testing.
# RESEND_API_KEY=replace-with-server-secret
# MAIL_FROM=DMA Hub <verified-sender@your-domain.example>

# Stripe settings MUST remain TEST mode if enabled.
# STRIPE_TEST_SECRET_KEY=sk_test_not_a_real_key
# STRIPE_TEST_WEBHOOK_SECRET=whsec_your_test_webhook
# STRIPE_TEST_SUCCESS_URL=http://localhost:5173/#/billing
# STRIPE_TEST_CANCEL_URL=http://localhost:5173/#/billing

# Optional local sandbox webhook; never expose on the public internet.
# DMA_SANDBOX_WEBHOOK_SECRET=replace-with-unique-32-plus-char-secret
