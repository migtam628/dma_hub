{
  "name": "dma-hub",
  "private": true,
  "version": "0.2.0",
  "packageManager": "npm@10.9.2",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev -w @dma-hub/web",
    "dev:api": "npm run dev -w @dma-hub/api",
    "build": "npm run build -w @dma-hub/web",
    "typecheck": "npm run typecheck -w @dma-hub/web",
    "test": "node --test tests/*.test.mjs && npm run test -w @dma-hub/api",
    "check": "npm run typecheck && npm run test && npm run build"
  }
}